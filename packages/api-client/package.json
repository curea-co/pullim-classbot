      "types": "./src/token-manager.ts",
      "default": "./src/token-manager.ts"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pullim-classbot/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
