{
  "name": "@pullim-classbot/api-client",
  "version": "0.0.1",
  "private": true,
  "description": "같은 오리진 /api/* 호출의 공용 조각 — ApiError 와 토큰 매니저.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
