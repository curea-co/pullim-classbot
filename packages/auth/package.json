{
  "name": "@pullim-classbot/auth",
  "version": "0.0.1",
  "private": true,
  "description": "IAuthProvider 인증 provider 추상화. 구현체는 apps/classbot 의 OsSsoAuthProvider(풀림 OS SSO).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/api": {
      "types": "./src/providers/api.ts",
      "default": "./src/providers/api.ts"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pullim-classbot/api-client": "workspace:*",
    "@pullim-classbot/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
